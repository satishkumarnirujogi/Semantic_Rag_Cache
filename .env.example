# --- LLM gateway (models and prices: config/models.yaml) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
SITE_URL=http://localhost:8000
SITE_NAME=Semantic-RAG-Cache

# --- Corpus: comma-separated folders; every supported file in them is indexed ---
# Formats: .pdf .html .htm .xhtml .md .markdown .rst .sgml .xml .txt
DOCS_DIRS=data/pdfs,data/corpus

# --- Qdrant ---
# server: the container from docker-compose.yml (`docker compose up -d qdrant`); required to run API + UI together
# local:  embedded storage in ./qdrant_storage; only ONE process (API or UI or ingest) at a time
QDRANT_MODE=server
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Retrieval (defaults shown) ---
# EMBED_MODEL=intfloat/multilingual-e5-base
# RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# RERANK_ENABLED=true
# RERANK_MAX_LENGTH=384
# CHUNK_TOKENS=320
# CHUNK_OVERLAP_TOKENS=48
# CANDIDATE_K=20
# CONTEXT_K=6
# MAX_CONTEXT_DOCS=3
# DOC_MARGIN=0.25
# Below MIN_RELEVANCE (reranker probability) the question is answered "not found" without an LLM call
# MIN_RELEVANCE=0.30
# A small-model refusal is escalated to the large model only above this relevance
# ESCALATION_RELEVANCE=0.50

# --- Semantic cache (calibrated with scripts/calibrate_cache_threshold.py) ---
# SIMILARITY_THRESHOLD=0.90
# CACHE_VERIFY=true
# CACHE_ALLOW_CROSS_LINGUAL=false
# CACHE_TTL_SECONDS=604800
